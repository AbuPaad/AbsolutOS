# calc_equals_key.numos — the hardware "=" key (KeyCode::EQUAL) must evaluate.
#
# On the production keypad "=" is row 2 / col 5 (SemanticId::equal, between `e`
# and `9`) — the execute key of the Casio layout. This script presses it and
# asserts CalculationApp actually computed 2+3=5 instead of inserting a literal
# "=" into the expression.
#
# Run:
#   program --headless --deterministic --script tests/emulator/scripts/calc_equals_key.numos \
#           --frames 900 --quiet
wait 200
open_app Calculation
wait 60
key 2
key +
key 3
key equal
wait 120
screenshot out/calc_equals_key.ppm
assert_app Calculation
assert_no_error
assert_result 5
