# equations.numos — Equations app (APP 02) captures for the website plate
# /assets/img/apps/equations-1..3.webp.
#
# App: Equations (src/apps/EquationsApp.cpp), NumOS theme (the app carries no
# casio code paths, so it renders numos under either theme — this is a numos
# capture).
#
# State machine (traced from EquationsApp.cpp):
#   EQ_LIST ──ENTER on "Add an equation"──▶ TEMPLATE ──ENTER (template 0
#   "Empty")──▶ EDITING ──ENTER (save)──▶ EQ_LIST ──ENTER on "Solve the
#   equation/system"──▶ SOLVING ─▶ RESULT (synchronous, inside the ENTER
#   press).  RESULT ──AC──▶ EQ_LIST.
#
# The website lists 3 shots; this script produces the two that are reachable
# and documents the third as a gap (see SHOT 2 below).
#
#   SHOT 1  /assets/img/apps/equations-1.webp
#     Quadratic x² − 5x + 6 = 0 solved exactly. Giac's solve returns one
#     group per root, so buildGiacResultDisplay() (EquationsApp.cpp:2662)
#     sets indexGroups and renders both roots as indexed lines:
#     x₁ = 2 and x₂ = 3.
#
#   SHOT 2  /assets/img/apps/equations-2.webp — COULD NOT CAPTURE.
#     The steps view has exactly one entry edge: KeyCode::SHOW_STEPS (R2C6)
#     in EquationsApp::handleKeyResult (EquationsApp.cpp:2089) — every other
#     key in RESULT is ignored or goes back. The emulator script grammar
#     (scriptNameToKeyCode, src/hal/NativeHal.cpp) contains no token that
#     produces SHOW_STEPS: the complete token set is ac/add/alpha/ans/back/
#     backspace/cos/dot/down/e/enter/exe/f1..f5/frac/freeeq/graph/gt/home/
#     left/ln/log/logbase/lparen/lt/mul/negate/pi/pow/preans/right/rparen/
#     shift/sin/sqrt/sto/sub/table/tan/up/x/y/zoom (+ symbols and digits),
#     and the emulator input spec (docs/specs/
#     NUMOS_EMULATOR_NATIVEHAL_APP_ROUTING_AND_INPUT_SPEC.md §E.2) lists
#     SHOW_STEPS among the KeyCodes with no script token. That was verified
#     empirically against the shipped binary: candidate tokens (show_steps,
#     steps, solve, trace, n, …) all abort the run with exit 2 "nombre de
#     tecla desconocido" at the fail-fast parse. Closing the gap requires a
#     src/ change (a new alias), which is outside this deliverable's scope —
#     so no step-view frame is invented in its place.
#
#   SHOT 3  /assets/img/apps/equations-3.webp
#     Two-equation linear system x+y=3, x−y=1 solved. Giac's gsolve returns
#     a single group holding both unknowns, so the result renders "Solution:"
#     with x = 2 and y = 1 together.
#
# Run (from repo root):
#   ./"C:/.piobuild/numOS/emulator_pc/program" --headless --deterministic \
#       --script tests/emulator/scripts/screenshots/equations.numos \
#       --fs-root tests/emulator/fs --frames 1400 --quiet
# Exit codes: 0 ok · 2 script/parse error · 3 screenshot write error · 4 assertion failure.

log "equations: waiting for launcher"
wait 200
assert_app Menu

# ───────────────── SHOT 1: quadratic solved exactly, indexed roots ────────
open_app Equations
wait 60
assert_app Equations
assert_theme numos

# EQ_LIST with 0 equations: the only row is "Add an equation", so the first
# ENTER opens the template chooser and the second picks template 0 (Empty),
# landing in the E1 editor.
key enter
key enter

# Author x^2 - 5x + 6 = 0. Keystroke shape proven by
# tests/emulator/scripts/equations_giac_quadratic_exact.numos; the
# digit-operator-digit runs follow equations_giac_single_linear.numos.
key x
key ^
key 2
key right
key -
key 5
key *
key x
key +
key 6
key =
key 0

# save E1 -> EQ_LIST, focus left on E1
key enter
# -> "Add an equation"
key down
# -> "Solve the equation"
key down
# solve (synchronous SOLVING -> RESULT)
key enter
wait 160

# Assert the RESULT state before capturing: engine, status, structured
# presentation, two solution groups (=> indexed x1/x2 lines), exact roots.
assert_app Equations
assert_theme numos
assert_equations_engine giac
assert_equations_status ok
assert_equations_result_kind structured
assert_equations_solution_count 2
assert_equations_solution_exact x 0 2
assert_equations_solution_exact x 1 3
assert_equations_tutor_status agreed
screenshot out/shots-equations-1.ppm
log "equations: shot 1 captured (x^2-5x+6=0 -> x1=2, x2=3, exact)"

# ───────────────── SHOT 3: two-equation linear system ─────────────────────
# Home schedules the app's deferred teardown (NativeHal.cpp:1617), which
# calls EquationsApp::end() and resets the equation list; 60 frames at the
# deterministic 16 ms step is past the 260 ms TEARDOWN_DELAY_MS, so the
# reopen below starts from a clean slate.
key home
wait 60
assert_app Menu

open_app Equations
wait 60
assert_app Equations
assert_theme numos

# E1: x + y = 3
# "Add an equation" -> template chooser
key enter
# Empty -> E1 editor
key enter
key x
key +
key y
key =
key 3
# save E1
key enter

# E2: x - y = 1 (focus walk: E1 -> "Add an equation" -> template -> editor)
key down
key enter
key enter
key x
key -
key y
key =
key 1
# save E2
key enter
# -> "Add an equation"
key down
# -> "Solve the system"
key down
# solve the system
key enter
wait 180

# Assert the RESULT state: one solution group, both unknowns together.
assert_app Equations
assert_theme numos
assert_equations_engine giac
assert_equations_status ok
assert_equations_result_kind structured
assert_equations_solution_count 1
assert_equations_solution_exact x 0 2
assert_equations_solution_exact y 0 1
screenshot out/shots-equations-3.ppm
log "equations: shot 3 captured (x+y=3, x-y=1 -> x=2, y=1)"

# SHOT 2 (steps view) is not produced: no script token exists for the
# SHOW_STEPS key that is the only edge into the STEPS state (see header).
log "equations: done (shots 1 and 3; shot 2 not reachable - no SHOW_STEPS token)"
