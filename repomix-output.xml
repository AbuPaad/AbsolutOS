        FLEX,      // Flex Sensor
        FSR_T,     // Force Sensitive Resistor
        NPN,       // NPN BJT
        PNP,       // PNP BJT
        NMOS_T,    // N-Channel MOSFET
        OPAMP,     // Op-Amp
