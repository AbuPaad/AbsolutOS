    if (args.size() < 2) {
        hostPrint("[convert] Usage: convert(quantity, \"unit_str\")\n");
        result = NeoValue::makeNull();
        return true;
    }
    if (!args[0].isQuantity() || !args[0].asQuantity()) {
        hostPrint("[convert] First argument must be a Quantity.\n");
        result = NeoValue::makeNull();
