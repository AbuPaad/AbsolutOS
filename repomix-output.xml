    }
    std::string targetStr = args[1].toString();
    if (targetStr.size() >= 2 && targetStr.front() == '"')
        targetStr = targetStr.substr(1, targetStr.size() - 2);

    auto* out = new NeoQuantity();
    if (!NeoUnits::convert(*args[0].asQuantity(), targetStr, *out)) {
        char buf[128];
