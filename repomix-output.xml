static constexpr uint32_t COL_INFO_TEXT   = 0xA0A0A0;
static constexpr uint32_t COL_RUN_ON      = 0x3FB950;
static constexpr uint32_t COL_RUN_OFF     = 0xFF4444;

// ── Toolbar labels (per page, 10 tools each) ────────────────────────────────
