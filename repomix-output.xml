    // Short line (negative terminal)
    dsc.color = lv_color_hex(0x4488FF);
    dsc.p1.x = cx + 4; dsc.p1.y = cy - 5;
    dsc.p2.x = cx + 4; dsc.p2.y = cy + 5;
