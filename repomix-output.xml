    "AND", "OR", "NOT", "NAN", "XOR", "1V5", "3V", "9V", "MTR", "RUN"
};
static const char** PAGE_LABELS[] = { PAGE0_LABELS, PAGE1_LABELS, PAGE2_LABELS };
