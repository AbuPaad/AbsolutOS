        // Page 0 — Basic
        RES = 0,   // Resistor
        VCC,       // Voltage Source
        GND,       // Ground
        LED,       // LED
        MCU,       // Microcontroller
        WIRE,      // Wire
        POT,       // Potentiometer
        BTN,       // Push-Button
