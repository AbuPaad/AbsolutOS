#endif

// ── Color palette ───────────────────────────────────────────────────────────
static constexpr uint32_t COL_BG          = 0x0D1117;
static constexpr uint32_t COL_GRID_LINE   = 0x1A2332;
static constexpr uint32_t COL_GRID_DOT    = 0x2A3342;
static constexpr uint32_t COL_CURSOR      = 0xFFD700;
