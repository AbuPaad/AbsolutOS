/**
 * ChemExtraData.h — Extended data and trivia for each element.
 *
 * Flash-resident (constexpr) — Zero RAM cost.
 * Index matches ELEMENTS[] in ChemDatabase.h (0-based, atomic number - 1).
 *
 * Part of: NumOS — Chemistry Module
 */

#pragma once
#include <cstdint>

namespace chem {

// Sentinel for unknown float values
constexpr float UNK = -9999.0f;

enum class PhysState : uint8_t { Solid, Liquid, Gas, Unknown };

struct ExtendedData {
    uint16_t  massNumber;        // A (most common isotope)
    uint16_t  atomicRadius;      // pm (0 = unknown)
    PhysState state;             // at 25 °C, 1 atm
    float     density;           // g/cm³ (gases: at STP); -1 = unknown
    float     meltingPoint;      // °C; UNK = unknown
    float     boilingPoint;      // °C; UNK = unknown
    float     electronAffinity;  // kJ/mol (positive = exothermic); UNK = unknown
    float     ionizationEnergy;  // kJ/mol (first); UNK = unknown
};

