// ════════════════════════════════════════════════════════════════════════════

static const char* DERIV_MESSAGES[] = {
    "Differentiating...",
    "Applying chain rule...",
    "Simplifying result...",
    "Computing derivative...",
    "Leibniz to the rescue...",
