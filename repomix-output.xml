#define LV_USE_IMGBTN       0
#define LV_USE_KEYBOARD     0
#define LV_USE_LABEL        1   /* Nombres de apps y t�tulos */
#define LV_USE_LED          0
#define LV_USE_LINE         1   /* Requerido por widgets internos (scale) */
