    };

    // ── LVGL objects ─────────────────────────────────────────────────────
    lv_obj_t*       _screen;
    lv_obj_t*       _drawObj;       // custom-drawn fluid area
    lv_obj_t*       _infoLabel;     // bottom info text
    lv_timer_t*     _simTimer;      // ~30 Hz simulation tick
